{
  "name": "cardity",
  "version": "0.1.0-alpha.1",
  "description": "Cardity Core - an agent protocol compiler for ABI, MCP, and Agent OS manifests",
  "bin": {
    "cardity": "bin/cardity.js",
    "cardity_agent": "bin/cardity_agent.js",
    "cardity_http_server": "bin/cardity_http_server.js",
    "cardity_mcp_server": "bin/cardity_mcp_server.js",
    "cardityc": "bin/cardityc.js",
    "cardity_runtime": "bin/cardity_runtime.js",
    "cardity_abi": "bin/cardity_abi.js",
    "cardity_manifest": "bin/cardity_manifest.js",
    "cardity_deploy": "bin/cardity_deploy.js",
    "cardity_drc20": "bin/cardity_drc20.js",
    "cardity_sdk": "bin/cardity_sdk.js",
    "cardity_package": "bin/cardity_package.js",
    "cardity_inscribe_plan": "bin/cardity_inscribe_plan.js",
    "cardity_inscribe": "bin/cardity_inscribe.js",
    "cardity_inscribe_full": "bin/cardity_inscribe_full.js"
  },
  "scripts": {
    "build": "mkdir -p build && cd build && cmake .. && make",
    "install": "npm run build",
    "postinstall": "node scripts/postinstall.js",
    "test": "bash scripts/smoke_test.sh",
    "serve": "node bin/cardity_http_server.js",
    "deploy:cloudflare": "wrangler deploy",
    "prepublishOnly": "npm run build",
    "ophex": "node bin/cardity_ophex.js",
    "encode:invoke": "node bin/cardity_encode_invoke.js",
    "split:parts": "node bin/cardity_split_parts.js",
    "check:imports": "node bin/cardity_check_imports.js"
  },
  "keywords": [
    "cardity",
    "agent-protocol",
    "agent-os",
    "mcp",
    "protocol",
    "compiler",
    "programming-language",
    "system-generation",
    "abi"
  ],
  "author": "Cardity Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardity-org/cardity-core.git"
  },
  "bugs": {
    "url": "https://github.com/cardity-org/cardity-core/issues"
  },
  "homepage": "https://github.com/cardity-org/cardity-core#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.4",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^20.0.0",
    "wrangler": "^4.93.1"
  },
  "files": [
    "bin/",
    "compiler/",
    "prompts/",
    "schemas/",
    "scripts/",
    "templates/",
    "examples/",
    "docs/",
    "CMakeLists.txt",
    "cardity_cli.cpp",
    "package_builder.cpp",
    "package_config.cpp",
    "package_manager.cpp",
    "package_manager.h",
    "registry_client.cpp",
    "registry_client.h",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
