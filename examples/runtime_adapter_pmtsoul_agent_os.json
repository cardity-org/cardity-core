{
  "schema": "cardity.runtime_adapter_contract.v1",
  "runtime": {
    "name": "PMTSoul Agent OS",
    "version": "0.1.0-alpha.cardity-v1",
    "homepage": "https://pmtsoul.com"
  },
  "supported_manifest_versions": ["cardity.agent_manifest.v1"],
  "supported_action_contracts": ["agent_action_contract_v1"],
  "supported_projection_contracts": ["projection_contract_v1_1"],
  "capabilities": {
    "register_actions": true,
    "permission_gate": true,
    "dry_run_executor": true,
    "write_executor": false,
    "readback_executor": true,
    "audit_sink": true,
    "replay_guard": true,
    "external_navigation": true,
    "external_services": true,
    "conformance_gate": true,
    "manifest_validation": true,
    "workspace_metadata": true,
    "diagnostics_surface": true
  },
  "production_write_policy": {
    "mode": "dry_run_only",
    "requires_permission_contract": true,
    "requires_confirm_required": true,
    "requires_readback_query": true,
    "requires_idempotency_key": true,
    "requires_replay_policy": true,
    "notes": "Production writes remain disabled until PMTSoul receives an explicit deployment/write permission contract."
  },
  "endpoints": {
    "conformance": "make cardity-validate",
    "run": "tools/generate_merchant_erp_catalog.py",
    "events": "generated workspace audit/event sinks"
  },
  "conformance": {
    "status": "passed",
    "report_url": "docs/generated/merchant-erp-cardity-conformance.json",
    "last_checked_at": "2026-05-23"
  },
  "notes": [
    "Merchant ERP is a downstream reference implementation only.",
    "Cardity remains the generic protocol/action/projection contract layer.",
    "PMTSoul blocks workspace generation when Cardity conformance fails."
  ]
}
