{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardity.org/schemas/checkpoint_contract_v1.schema.json",
  "title": "Cardity Checkpoint Contract v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "scope", "checkpoints", "ledger", "recovery_policy"],
  "properties": {
    "schema": { "const": "cardity.checkpoint_contract.v1" },
    "scope": { "enum": ["action", "workflow", "module", "system"] },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "after", "verify", "expected_state", "on_failure"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "after": { "type": ["string", "object"] },
          "verify": {
            "type": "object",
            "additionalProperties": true,
            "required": ["query", "expected_fields", "status_field"],
            "properties": {
              "query": { "type": ["object", "string"] },
              "expected_fields": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "status_field": { "type": "string", "minLength": 1 },
              "pass_values": {
                "type": "array",
                "items": { "type": ["string", "number", "boolean", "null"] }
              }
            }
          },
          "expected_state": {
            "type": "object",
            "additionalProperties": true
          },
          "on_failure": {
            "type": "object",
            "additionalProperties": true,
            "required": ["mode", "max_attempts"],
            "properties": {
              "mode": { "enum": ["retry", "stop", "manual_review", "compensating_action"] },
              "max_attempts": { "type": "integer", "minimum": 0 },
              "recovery_hint": { "type": "string" }
            }
          }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": true,
      "required": ["event", "append_fields", "source_run_id", "checkpoint_index"],
      "properties": {
        "event": { "type": "string", "minLength": 1 },
        "append_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_run_id": { "type": "string", "minLength": 1 },
        "checkpoint_index": { "type": "string", "minLength": 1 }
      }
    },
    "recovery_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "on_unrecoverable"],
      "properties": {
        "mode": { "enum": ["none", "retry", "manual", "compensating_action"] },
        "on_unrecoverable": { "enum": ["stop", "manual_review", "continue_with_warning"] },
        "compensation_action": { "type": ["string", "null"] }
      }
    }
  }
}
