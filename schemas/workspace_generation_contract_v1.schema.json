{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardity.org/schemas/workspace_generation_contract_v1.schema.json",
  "title": "Cardity Workspace Generation Contract v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "tenant_scope",
    "workspace",
    "resource_mapping",
    "role_tool_bindings",
    "account_conformance"
  ],
  "properties": {
    "schema": { "const": "cardity.workspace_generation_contract.v1" },
    "tenant_scope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["account_key", "workspace_key", "tenant_keys", "isolation_policy"],
      "properties": {
        "enterprise_key": { "type": "string", "minLength": 1 },
        "account_key": { "type": "string", "minLength": 1 },
        "workspace_key": { "type": "string", "minLength": 1 },
        "tenant_keys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "isolation_policy": {
          "type": "object",
          "additionalProperties": true,
          "required": ["mode", "runtime_owned"],
          "properties": {
            "mode": { "enum": ["metadata_only", "runtime_enforced"] },
            "runtime_owned": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "target_runtime", "generated_artifacts"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "target_runtime": { "type": "string", "minLength": 1 },
        "generated_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "api",
              "database",
              "ui",
              "workflow",
              "agent_roles",
              "permissions",
              "audit",
              "recovery",
              "deliverables",
              "documents",
              "media",
              "integrations"
            ]
          }
        }
      }
    },
    "resource_mapping": {
      "type": "object",
      "additionalProperties": true,
      "required": ["actions", "read_models", "projections", "queries", "checkpoints"],
      "properties": {
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_mapping" }
        },
        "read_models": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_mapping" }
        },
        "projections": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_mapping" }
        },
        "queries": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_mapping" }
        },
        "checkpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_mapping" }
        },
        "deliverables": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_mapping" }
        },
        "documents": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_mapping" }
        },
        "media": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_mapping" }
        },
        "integrations": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_mapping" }
        }
      }
    },
    "role_tool_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["role", "allowed_actions", "allowed_tools", "permission_scope"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "allowed_actions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "allowed_tools": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "permission_scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "account_conformance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required", "checks", "metadata_fields"],
      "properties": {
        "required": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "tenant_scope_present",
              "workspace_metadata_present",
              "actions_mapped",
              "read_models_mapped",
              "roles_bound",
              "permissions_bound",
              "checkpoints_bound",
              "audit_replay_metadata_present",
              "enterprise_scope_present",
              "account_scope_present",
              "workspace_scope_present",
              "resources_tenant_scoped",
              "role_tool_permissions_bound",
              "deliverables_tenant_scoped",
              "audit_tenant_scoped",
              "cross_account_leak_check"
            ]
          }
        },
        "metadata_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "resource_mapping": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "tenant_scoped_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
