{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardity.org/schemas/projection_contract_v1_1.schema.json",
  "title": "Cardity Projection Contract v1.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["system"],
  "properties": {
    "system": {
      "type": "object",
      "required": ["database"],
      "properties": {
        "database": {
          "type": "object",
          "required": ["read_models", "projections", "queries"],
          "properties": {
            "tables": { "type": "array" },
            "events": { "type": "array" },
            "read_models": {
              "type": "array",
              "items": { "$ref": "#/$defs/read_model" }
            },
            "queries": {
              "type": "array",
              "items": { "$ref": "#/$defs/query" }
            },
            "projections": {
              "type": "array",
              "items": { "$ref": "#/$defs/projection" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "nullable": { "type": "boolean" },
        "default": {}
      }
    },
    "read_model": {
      "type": "object",
      "required": ["name", "columns", "primary_key"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        },
        "primary_key": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "indexes": { "type": "array" },
        "query_contracts": { "type": "array" }
      }
    },
    "query": {
      "type": "object",
      "required": ["name", "read_model", "operation"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "read_model": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["list", "detail", "summary", "aggregate"] },
        "filters": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "projection": {
      "type": "object",
      "required": ["name", "version", "on", "writes"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "enum": ["event", "confirmed_readback"] },
        "source_path": { "type": "string" },
        "source_id": { "type": "string" },
        "idempotency": {
          "type": "object",
          "required": ["source_id", "source_run_id", "projection_version", "write_index"],
          "additionalProperties": true,
          "properties": {
            "source_id": { "type": "string" },
            "source_run_id": { "type": "string" },
            "projection_version": { "type": "string" },
            "write_index": { "type": "string" }
          }
        },
        "on": {
          "type": "object",
          "required": ["event"],
          "properties": {
            "event": { "type": "string", "minLength": 1 }
          }
        },
        "writes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projection_write" }
        }
      }
    },
    "projection_write": {
      "type": "object",
      "required": ["table", "operation"],
      "additionalProperties": true,
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "operation": {
          "enum": ["insert", "upsert_delta", "upsert_snapshot", "delete", "soft_delete"]
        },
        "key": {
          "oneOf": [
            { "type": "object" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          ]
        },
        "values": { "type": "object" },
        "snapshot": { "type": "object" },
        "delta": { "type": "object" }
      }
    }
  }
}
