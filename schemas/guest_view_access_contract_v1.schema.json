{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardity.org/schemas/guest_view_access_contract_v1.schema.json",
  "title": "Cardity Guest View Access Contract v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "scope",
    "token_policy",
    "allowed_read_endpoints",
    "forbidden_actions",
    "sse_policy",
    "audit_policy",
    "conformance",
    "runtime_boundary"
  ],
  "properties": {
    "schema": { "const": "cardity.guest_view_access_contract.v1" },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scope_keys", "access_mode"],
      "properties": {
        "scope_keys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "access_mode": { "const": "guest_view_only" }
      }
    },
    "token_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["token_type", "expires_required", "revocable", "scope_bound"],
      "properties": {
        "token_type": { "enum": ["guest", "share", "invite"] },
        "expires_required": { "type": "boolean" },
        "revocable": { "type": "boolean" },
        "scope_bound": { "type": "boolean" }
      }
    },
    "allowed_read_endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["endpoint", "method", "resource", "scope_filter_required"],
        "properties": {
          "endpoint": { "type": "string", "minLength": 1 },
          "method": { "enum": ["GET"] },
          "resource": { "type": "string", "minLength": 1 },
          "scope_filter_required": { "type": "boolean" }
        }
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["action", "reason"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sse_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["read_only", "allowed_event_types", "forbidden_event_types", "scope_filter_required"],
      "properties": {
        "read_only": { "type": "boolean" },
        "allowed_event_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_event_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scope_filter_required": { "type": "boolean" }
      }
    },
    "audit_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required_events"],
      "properties": {
        "required_events": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtime_boundary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["cardity_owns", "runtime_owns"],
      "properties": {
        "cardity_owns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "runtime_owns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
