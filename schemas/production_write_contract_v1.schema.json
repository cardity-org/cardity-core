{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardity.org/schemas/production_write_contract_v1.schema.json",
  "title": "Cardity Production Write Contract v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "permission",
    "confirm_policy",
    "confirmation_ui",
    "readback",
    "idempotency",
    "audit",
    "replay_policy",
    "compensation_policy"
  ],
  "properties": {
    "schema": { "const": "cardity.production_write_contract.v1" },
    "permission": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "scope", "grant_required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "grant_required": { "type": "boolean" },
        "runtime_grant_ref": { "type": ["string", "null"] }
      }
    },
    "confirm_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required", "required_before", "expires_after_seconds"],
      "properties": {
        "required": { "type": "boolean" },
        "required_before": { "enum": ["dry_run", "write_commit", "readback"] },
        "expires_after_seconds": { "type": "integer", "minimum": 0 },
        "approver_context": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confirmation_ui": {
      "type": "object",
      "additionalProperties": true,
      "required": ["states", "runnable_states", "terminal_states"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "draft",
              "preparing",
              "pending",
              "approved",
              "verified",
              "failed",
              "expired",
              "cancelled"
            ]
          }
        },
        "runnable_states": {
          "type": "array",
          "items": { "enum": ["approved", "verified"] }
        },
        "terminal_states": {
          "type": "array",
          "items": { "enum": ["verified", "failed", "expired", "cancelled"] }
        },
        "disabled_reason_field": { "type": ["string", "null"] }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required", "query", "expected_fields", "verification_status", "stale_write_policy"],
      "properties": {
        "required": { "type": "boolean" },
        "query": { "type": ["object", "string", "null"] },
        "expected_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "verification_status": { "enum": ["not_required", "pending", "verified", "failed"] },
        "stale_write_policy": { "enum": ["block", "warn", "allow"] }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "source_id", "write_index"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "write_index": { "type": "string", "minLength": 1 },
        "replay_window_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["event", "fields"],
      "properties": {
        "event": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "replay_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "on_replay", "dedupe_tuple"],
      "properties": {
        "mode": { "enum": ["idempotent_command", "read_only", "not_replayable"] },
        "on_replay": { "enum": ["return_prior_result", "skip", "fail", "manual_review"] },
        "dedupe_tuple": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compensation_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "manual", "compensating_action"] },
        "action": { "type": ["string", "null"] },
        "required_context": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "long_running_task": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "task_id": { "type": ["string", "null"] },
        "status_query": { "type": ["object", "string", "null"] },
        "progress_event": { "type": ["string", "null"] },
        "result_readback": { "type": ["object", "string", "null"] },
        "timeout_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "role_scope": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "skill_whitelist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tool_permissions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "credential_required": { "type": "boolean" },
        "visibility": { "enum": ["visible", "hidden", "conditional"] },
        "runnable_when": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
